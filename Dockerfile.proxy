FROM node:22-alpine AS showcase-deps

WORKDIR /app/showcase

COPY showcase/package*.json ./
RUN npm ci

FROM node:22-alpine AS showcase-build

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1
ENV SHOWCASE_STATIC_EXPORT=1

COPY --from=showcase-deps /app/showcase/node_modules ./showcase/node_modules
COPY showcase ./showcase

WORKDIR /app/showcase

RUN npm run build

FROM nginx:1.27-alpine AS runtime

COPY nginx.proxy.conf /etc/nginx/nginx.conf
COPY --from=showcase-build /app/showcase/out /usr/share/nginx/html

RUN mkdir -p /usr/share/nginx/html/demo-assets \
  && if [ -d /usr/share/nginx/html/_next ]; then mv /usr/share/nginx/html/_next /usr/share/nginx/html/demo-assets/_next; fi
