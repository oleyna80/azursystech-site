# Stage 1: Install dependencies
FROM node:22-alpine AS deps

WORKDIR /app/admin

COPY admin/package*.json ./
RUN npm ci

# Stage 2: Build Next.js standalone bundle
FROM node:22-alpine AS build

WORKDIR /app/admin

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app/admin/node_modules ./node_modules
COPY admin/ ./
RUN npm run build

# Stage 3: Runtime
FROM node:22-alpine AS runtime

WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    HOST=0.0.0.0 \
    PORT=3000

COPY --from=build /app/admin/.next/standalone ./
COPY --from=build /app/admin/.next/static ./.next/static

EXPOSE 3000

CMD ["node", "server.js"]
