{
  "agents": {
    "lead_router": {
      "description": "Classifies and drafts first response for inbound leads.",
      "model": "deepseek-chat",
      "temperature": 0.2,
      "requires_approval": true,
      "required_fields": [
        "lead_message",
        "source",
        "language"
      ],
      "context_files": [
        "00_strategy/positioning.md",
        "00_strategy/offer-stack.md",
        "01_brand/brand-pack.md",
        "03_leads/lead-taxonomy.md",
        "03_leads/response-templates.md",
        "05_ai/lead-agent-spec.md",
        "05_ai/approval-workflow.md",
        "05_ai/escalation-rules.md",
        "05_ai/prompt-library-support.md"
      ],
      "system_prompt_file": "05_ai/prompts/lead_router_system.md",
      "user_prompt_file": "05_ai/prompts/lead_router_user.md",
      "structured_output": {
        "escalation_required_field": "escalation_required",
        "escalation_detail_fields": [
          "escalation_level",
          "escalation_category",
          "risk_reason",
          "suggested_human_action"
        ],
        "field_order": [
          "lead_type",
          "intent",
          "urgency",
          "confidence",
          "escalation_required",
          "escalation_level",
          "escalation_category",
          "risk_reason",
          "suggested_human_action",
          "draft_reply",
          "next_internal_action"
        ],
        "multiline_fields": [
          "draft_reply"
        ],
        "fields": [
          {
            "name": "lead_type",
            "required": true,
            "enum": ["particulier", "tpe", "unknown"]
          },
          {
            "name": "intent",
            "required": true
          },
          {
            "name": "urgency",
            "required": true,
            "enum": ["low", "medium", "high"]
          },
          {
            "name": "confidence",
            "required": true,
            "type": "integer",
            "min": 0,
            "max": 100
          },
          {
            "name": "escalation_required",
            "required": true,
            "enum": ["yes", "no"]
          },
          {
            "name": "escalation_level",
            "nullable": true,
            "enum": ["1", "2", "3"]
          },
          {
            "name": "escalation_category",
            "nullable": true
          },
          {
            "name": "risk_reason",
            "nullable": true
          },
          {
            "name": "suggested_human_action",
            "nullable": true
          },
          {
            "name": "draft_reply",
            "required": true
          },
          {
            "name": "next_internal_action",
            "required": true
          }
        ]
      },
      "escalation_keywords": [
        "legal",
        "lawsuit",
        "threat",
        "security breach",
        "ransomware",
        "data loss",
        "refund",
        "angry",
        "complaint",
        "urgent"
      ]
    },
    "content_writer": {
      "description": "Generates website and social content drafts in brand voice.",
      "model": "deepseek-chat",
      "temperature": 0.4,
      "requires_approval": true,
      "required_fields": [
        "task",
        "asset_type",
        "language"
      ],
      "context_files": [
        "00_strategy/positioning.md",
        "00_strategy/offer-stack.md",
        "01_brand/brand-pack.md",
        "01_brand/homepage-copy.md",
        "04_facebook/facebook-strategy.md",
        "05_ai/content-engine-spec.md",
        "05_ai/approval-workflow.md",
        "05_ai/prompt-library-content.md"
      ],
      "system_prompt_file": "05_ai/prompts/content_writer_system.md",
      "user_prompt_file": "05_ai/prompts/content_writer_user.md",
      "escalation_keywords": [
        "guarantee",
        "medical",
        "financial advice",
        "fake review",
        "competitor attack"
      ]
    }
  }
}
