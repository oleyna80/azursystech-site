{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/azur/Projects/WSL/azursystech/.codex/hooks/hard-stop.sh'",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/azur/Projects/WSL/azursystech/.codex/hooks/critic-gate.sh'",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/azur/Projects/WSL/azursystech/.codex/hooks/secret-scan.sh'",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "apply_patch|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/azur/Projects/WSL/azursystech/.codex/hooks/typecheck.sh'",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/azur/Projects/WSL/azursystech/.codex/hooks/verification-gate.sh'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
