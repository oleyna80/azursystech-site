{
  "description": "Project-local Codex adapters over the shared SDLC v1 controller and non-lifecycle consequential guard.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/sdlc-v1-bridge.py\" consequential",
            "timeout": 10,
            "statusMessage": "Checking consequential external boundaries"
          }
        ]
      },
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/sdlc-v1-bridge.py\" runtime --runtime codex",
            "timeout": 10,
            "statusMessage": "Checking shared SDLC v1 structured-write authority"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/sdlc-v1-bridge.py\" subagent-context --runtime codex",
            "timeout": 5,
            "statusMessage": "Loading shared SDLC v1 Work Block context"
          }
        ]
      }
    ]
  }
}
