# Optional project-local Codex config template.
#
# Copy to `.codex/config.toml` only when this project needs local Codex
# overrides. Commit only secret-free policy/templates; keep machine-specific
# provider settings outside Git.
#
# Codex can run the shared Agentic SDLC contract independently. Claude Code is
# a separate runtime/team layer available through the handoff contract when
# that extra architecture is useful.
#
# Do not store secrets or provider tokens in this file.
#
# Keep real model/provider settings and role-level model, reasoning, and sandbox
# overrides in user-level Codex config or private `.codex/agents/*.toml` files.
# This template must not ship model IDs, API keys, proxy URLs, or
# organization-specific provider definitions.

[features]
multi_agent = true

[agents]
max_threads = 3
max_depth = 1
job_max_runtime_seconds = 1800
interrupt_message = true

