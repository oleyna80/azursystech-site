#!/usr/bin/env bash
set -euo pipefail

message_file="${1:?commit message file is required}"
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "${repo_root}" ] || exit 0
state_file="${repo_root}/.agent/active-work-block.json"

fail() { echo "commit-msg: $*" >&2; exit 1; }

[ -f "${state_file}" ] || fail "canonical lifecycle state is missing; run bootstrap/lifecycle checks"
set +e
state_output="$(python3 - "${state_file}" <<'PY'
import json
import re
import sys

try:
    value = json.loads(open(sys.argv[1], encoding="utf-8").read())
except (OSError, json.JSONDecodeError) as exc:
    print(f"invalid canonical lifecycle state: {exc}", file=sys.stderr)
    raise SystemExit(2)
if not isinstance(value, dict) or value.get("schema_version") != 3:
    print("unsupported or invalid canonical lifecycle state", file=sys.stderr)
    raise SystemExit(2)
work_block_id = value.get("work_block_id")
subject_branch = value.get("subject_branch")
if work_block_id == "":
    print("INACTIVE")
    raise SystemExit(0)
pattern = re.compile(r"^WB-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$")
if not isinstance(work_block_id, str) or not pattern.fullmatch(work_block_id):
    print("active lifecycle state has invalid work_block_id", file=sys.stderr)
    raise SystemExit(2)
if not isinstance(subject_branch, str) or not subject_branch:
    print("active lifecycle state has missing or invalid subject_branch", file=sys.stderr)
    raise SystemExit(2)
print(f"ACTIVE\t{work_block_id}\t{subject_branch}")
PY
)"
state_exit=$?
set -e
[ "${state_exit}" -eq 0 ] || fail "${state_output:-could not read canonical lifecycle state}"
[ "${state_output}" = "INACTIVE" ] && exit 0
IFS=$'\t' read -r state_kind expected_work_block expected_branch <<< "${state_output}"
[ "${state_kind}" = "ACTIVE" ] || fail "could not determine canonical lifecycle state"

current_branch="$(git branch --show-current)"
[ -n "${current_branch}" ] || fail "active Work Block ${expected_work_block} cannot commit from detached HEAD"
[ "${current_branch}" = "${expected_branch}" ] || \
  fail "active Work Block ${expected_work_block} is bound to ${expected_branch}, current branch is ${current_branch}"

parsed_trailers="$(git interpret-trailers --parse < "${message_file}")" || fail "could not parse commit trailers"
mapfile -t work_block_trailers < <(printf '%s\n' "${parsed_trailers}" | awk '$1 == "Work-Block:" { print }')
case "${#work_block_trailers[@]}" in
  0) fail "active Work Block ${expected_work_block} requires exactly one Work-Block: trailer" ;;
  1) ;;
  *) fail "active Work Block ${expected_work_block} requires exactly one Work-Block: trailer; found ${#work_block_trailers[@]}" ;;
esac
actual_work_block="${work_block_trailers[0]#Work-Block:}"
actual_work_block="${actual_work_block#${actual_work_block%%[![:space:]]*}}"
actual_work_block="${actual_work_block%${actual_work_block##*[![:space:]]}}"
[[ "${actual_work_block}" =~ ^WB-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*$ ]] || \
  fail "Work-Block trailer is malformed: ${actual_work_block:-missing}"
[ "${actual_work_block}" = "${expected_work_block}" ] || \
  fail "Work-Block trailer ${actual_work_block} does not match active Work Block ${expected_work_block}"
