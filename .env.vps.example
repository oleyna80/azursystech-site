# AzurSysTech VPS runtime template
# Copy this file to .env on VPS and replace placeholder values.

HOSTNAME=0.0.0.0
HOST=0.0.0.0
PORT=3000

ALLOWED_ORIGINS=https://azursystech.fr,https://www.azursystech.fr

DEEPSEEK_API_KEY=replace_me
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_LAUNCH_MODE=limited_live_intake
AI_ALLOW_AUTONOMOUS_OUTBOUND=false
AI_ALLOW_PRICING_COMMITMENTS=false
AI_ALLOW_SCHEDULING_PROMISES=false

AZURSYSTECH_CONTACT_SUBMIT_ENABLED=false
AZURSYSTECH_CONTACT_SUBMIT_BASE_URL=
AZURSYSTECH_CONTACT_SUBMIT_TOKEN=

# PostgreSQL (self-hosted in docker compose)
POSTGRES_DB=azursystech
POSTGRES_USER=azursystech_app
POSTGRES_PASSWORD=replace_me_strong_password

# Intake storage mode:
# - legacy: no SQL write
# - dual: SQL + downstream integration
# - sql_primary: SQL is primary, downstream optional
INTAKE_STORAGE_MODE=sql_primary
DATABASE_URL=postgresql://azursystech_app:replace_me_strong_password@postgres:5432/azursystech

# Optional monitoring
UPTIME_ALERT_WEBHOOK=
