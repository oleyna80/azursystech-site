# AzurSysTech VPS runtime template
# Copy this file to .env on VPS and replace placeholder values.

HOSTNAME=0.0.0.0
HOST=0.0.0.0
PORT=3000

# Keep the existing production compose project name when running from
# /home/dmitrii/apps/azursystech, otherwise Compose creates a second stack.
COMPOSE_PROJECT_NAME=azursystech-site

APP_IMAGE=ghcr.io/oleyna80/azursystech-app:replace_me_immutable_tag
ADMIN_IMAGE=ghcr.io/oleyna80/azursystech-admin:replace_me_immutable_tag

ALLOWED_ORIGINS=https://azursystech.fr,https://www.azursystech.fr
# The app containers are reachable through the local nginx reverse proxy, which
# sets X-Forwarded-For/X-Real-IP. Keep this true so mutation route rate limits
# key by client IP instead of broad User-Agent/Accept-Language buckets.
AZURSYSTECH_TRUST_PROXY_HEADERS=true

DEEPSEEK_API_KEY=replace_me
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_LAUNCH_MODE=limited_live_intake
AI_ALLOW_AUTONOMOUS_OUTBOUND=false
AI_ALLOW_PRICING_COMMITMENTS=false
AI_ALLOW_SCHEDULING_PROMISES=false

# Required for Facebook data deletion callbacks.
META_APP_SECRET=replace_me
# Optional fallback only; prefer META_APP_SECRET.
FACEBOOK_APP_SECRET=

AZURSYSTECH_CONTACT_SUBMIT_ENABLED=false
AZURSYSTECH_CONTACT_SUBMIT_BASE_URL=
AZURSYSTECH_CONTACT_SUBMIT_TOKEN=
# Comma-separated webhook hosts allowlist.
# Required and non-empty in production when AZURSYSTECH_CONTACT_SUBMIT_ENABLED=true.
# Example: n8n.azursystech.fr,hooks.azursystech.fr
AZURSYSTECH_CONTACT_SUBMIT_ALLOWED_HOSTS=

# Optional Telegram lead notifications from intake backend.
# Enabled only when set to true. All variables below are optional unless enabled.
AZURSYSTECH_TELEGRAM_NOTIFICATIONS_ENABLED=false
AZURSYSTECH_TELEGRAM_BOT_TOKEN=
AZURSYSTECH_TELEGRAM_CHAT_ID=
# Optional topic/thread id for Telegram forum groups.
AZURSYSTECH_TELEGRAM_THREAD_ID=
# Optional API base URL override (default: https://api.telegram.org).
AZURSYSTECH_TELEGRAM_API_BASE_URL=https://api.telegram.org

# Telegram bot webhook receive (separate from admin notifications above).
# TELEGRAM_WEBHOOK_RECEIVE_ENABLED: when true, the live webhook route accepts
# Telegram updates and persists them. Keep false until webhook registration
# is approved and the secret is set.
TELEGRAM_WEBHOOK_RECEIVE_ENABLED=false
# Secret token Telegram sends in X-Telegram-Bot-Api-Secret-Token header.
# Owner-generated, never committed. Must match the setWebhook secret_token.
TELEGRAM_WEBHOOK_SECRET=

# PostgreSQL (self-hosted in docker compose)
POSTGRES_DB=azursystech
POSTGRES_USER=azursystech_app
POSTGRES_PASSWORD=replace_me_strong_password

# Intake storage mode:
# - legacy: no SQL write
# - dual: SQL + downstream integration
# - sql_primary: SQL is primary, downstream optional
INTAKE_STORAGE_MODE=sql_primary
DATABASE_URL=postgresql://azursystech_app:replace_me_strong_password@postgres:5432/azursystech
# PostgreSQL TLS mode (used by web/src/lib/intake-storage.ts):
# - disable (default): no TLS; safe for current internal Docker postgres
# - require: TLS enabled, certificate is not strictly verified
# - verify-full: TLS enabled with certificate verification (reject unauthorized)
# DATABASE_SSL_MODE=disable

# Admin runtime
ADMIN_AUTH_ENABLED=true
ADMIN_SESSION_SECRET=replace_me_min_32_chars
ADMIN_PASSWORD_HASH=replace_me_scrypt_hash
ADMIN_SCHEDULER_SECRET=replace_me_min_32_chars
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_DB_POOL_MAX=2

# Optional monitoring
UPTIME_ALERT_WEBHOOK=
