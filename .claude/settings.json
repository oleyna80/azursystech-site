{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/sdlc-v1-bridge.py\" consequential",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/sdlc-v1-bridge.py\" runtime --runtime claude",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/typecheck.sh",
            "timeout": 30000
          }
        ]
      }
    ]
  },
  "agents": {
    "solution-architect": {
      "description": "Architecture and technical discovery for the Architect function (read-only)",
      "color": "green"
    },
    "critic": {
      "description": "Challenges Define-stage scope, assumptions, risk, and assurance design (read-only)",
      "color": "yellow"
    },
    "reviewer": {
      "description": "Independent engineering review of the frozen diff (read-only)",
      "color": "yellow"
    },
    "scoped-coder": {
      "description": "Implementation inside one approved Work Block write-set",
      "color": "blue"
    },
    "verifier": {
      "description": "Acceptance-criteria and runtime verification with evidence (read-only)",
      "color": "red"
    }
  }
}
